APP_NAME="Estate in Paris"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

INERTIA_SSR_ENABLED=true

SEO_ORG_EMAIL=contact@estateinparis.com
SEO_ORG_PHONE="+33 6 59 25 36 95"
SEO_ORG_STREET="22 Rue Notre Dame de Nazareth"
SEO_ORG_CITY=Paris
SEO_ORG_POSTAL_CODE=75003
SEO_SOCIAL_LINKEDIN=https://www.linkedin.com/
SEO_SOCIAL_THREADS=https://www.threads.net/
SEO_SOCIAL_FACEBOOK=https://www.facebook.com/
SEO_OPENING_HOURS="Mo-Sa 09:00-19:00"
SEO_GOOGLE_RATING=4.9
SEO_GOOGLE_REVIEW_COUNT=128
SEO_GOOGLE_REVIEWS_URL=https://www.google.com/maps
SEO_AGENT_NAME="Camille Laurent"
SEO_AGENT_ROLE="Conseillère immobilier"
