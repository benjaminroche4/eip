APP_NAME="Estate in Paris"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=estate_in_paris
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Google Tag Manager : ID du conteneur (GTM-XXXXXXX) ; vide en local / tests = aucun script injecté
GTM_ID=
SEO_VIDEO_BUY=
SEO_VIDEO_SELL=

# Google Maps Platform (Places autocomplete, formulaire d'estimation)
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=

MAIL_MAILER=log   # resend en prod (clé ci-dessous), log en dev si pas de clé
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="contact@estate-in-paris.fr"
MAIL_FROM_NAME="${APP_NAME}"

# Resend (transactionnel) — https://resend.com/api-keys ; MAIL_FROM_ADDRESS doit être sur un domaine vérifié dans Resend
RESEND_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

INERTIA_SSR_ENABLED=true   # local: with `php artisan inertia:start-ssr`; prod: true ONLY once the SSR process runs (incident 2026-09-16), the config default is false
SESSION_SECURE_COOKIE=true   # prod: cookies flagged Secure (HTTPS only); set false in local HTTP
SEO_SITEMAP_DIR=   # where `sitemap:generate` writes, relative to the project root (empty = public/)

SEO_ORG_EMAIL=contact@estate-in-paris.fr
SEO_ORG_PHONE="+33 1 88 83 73 30"
SEO_ORG_WHATSAPP=33659253695
SEO_ADVISOR_NAME="Charles Mata"
SEO_ADVISOR_ROLE_FR="Conseiller senior immobilier de prestige"
SEO_ADVISOR_ROLE_EN="Senior Luxury Property Advisor"
SEO_ADVISOR_PHOTO=/images/advisors/advisor-1.webp
SEO_ADVISOR_EXPERIENCE_YEARS=12
SEO_ORG_STREET="3 rue Grégoire de Tours"
SEO_ORG_CITY=Paris
SEO_ORG_POSTAL_CODE=75006
SEO_SOCIAL_LINKEDIN=https://www.linkedin.com/company/estate-in-paris
SEO_OPENING_HOURS="Mo-Fr 08:00-20:00, Sa 08:00-12:00"
SEO_GOOGLE_RATING=4.9
SEO_GOOGLE_REVIEW_COUNT=150
SEO_GOOGLE_REVIEWS_URL=https://www.google.com/maps
SEO_GOOGLE_MAPS_URL=
SEO_LLMS_SUMMARY=
SEO_LLMS_SUMMARY_EN=
# Entities and defaults (prod: real values, never the config placeholders, audit 2026-10-12)
SEO_SITE_NAME="Estate in Paris"
SEO_DESCRIPTION="Estate in Paris, agence immobilière de prestige à Paris : achat, vente et estimation de biens d'exception, en toute confidentialité."
SEO_DEFAULT_IMAGE=/og-default.jpg
SEO_TWITTER=
SEO_ORG_NAME="Estate in Paris"
SEO_ORG_LEGAL_NAME="Bridgeline Group Sàrl"
SEO_ORG_COUNTRY=FR
SEO_ORG_SAME_AS=
SEO_OPENING_HOURS_FR="Lun - Ven, 8h - 20h · Sam, 8h - 12h"
SEO_OPENING_HOURS_EN="Mon - Fri, 8am - 8pm · Sat, 8am - 12pm"

# Sanity (CMS blog / marketplace) — token = secret, jamais exposé au front
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2025-02-09
SANITY_TOKEN=
# false en dev (contenu frais), true en prod (CDN, contenu public)
SANITY_BLOG_TYPE=estateBlog
SANITY_CATEGORY_TYPE=estateCategory
SANITY_USE_CDN=false
SEO_RELOCATION_URL=https://relocation-in-paris.fr/
# Code à 6 chiffres remis par l'agence : déverrouille les biens off-market pour la session (vide = jamais déverrouillable)
OFF_MARKET_CODE=
